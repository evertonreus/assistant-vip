# Copia a /opt/assistant/web.env en la VPS (permisos 600). NUNCA subir a Git ni a OneDrive.
APP_USER=everton
# Generar con: docker run --rm -i -v /opt/assistant/web/scripts:/s node:22-slim node /s/hash-password.mjs
APP_PASSWORD_HASH=scrypt:16384:8:1:SALT:HASH
# Generar con: openssl rand -base64 48
SESSION_SECRET=
# Opcional: secreto compartido que n8n puede validar en el encabezado X-Assistant-Secret
N8N_WEBHOOK_SECRET=
